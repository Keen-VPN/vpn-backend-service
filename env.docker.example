# ========================================
# KeenVPN Backend - Docker Environment
# ========================================
# Copy this file to .env and fill in your values
# This file is used by docker-compose.yml

# ========================================
# Database Configuration (PostgreSQL)
# ========================================
POSTGRES_USER=keenvpn
POSTGRES_PASSWORD=keenvpn_dev_password
POSTGRES_DB=keenvpn
POSTGRES_PORT=5432

# Database URL (automatically constructed in docker-compose)
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL=postgresql://keenvpn:keenvpn_dev_password@postgres:5432/keenvpn?schema=public

# ========================================
# Application Configuration
# ========================================
NODE_ENV=development
CONFIG_ADMIN_TOKEN=change-me-config-admin-token
PORT=3003

# ========================================
# Firebase Configuration
# ========================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project-id.iam.gserviceaccount.com

# ========================================
# Stripe Configuration
# ========================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_price_id

# ========================================
# JWT Configuration
# ========================================
JWT_SECRET=your_jwt_secret_min_32_characters_long


# ========================================
# Plan Configuration
# ========================================
PLAN_PRICE=100
PLAN_NAME=Premium VPN Service
PLAN_FEATURES=Unlimited bandwidth, Premium support, Secure & private browsing

# ========================================
# Tunnelto.dev Configuration (Disabled in Docker)
# ========================================
TUNNELTO_ENABLED=false
TUNNELTO_SUBDOMAIN=keenvpn
TUNNELTO_PORT=3003

# ========================================
# pgAdmin Configuration (Optional)
# ========================================
PGADMIN_EMAIL=admin@keenvpn.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

