{
  "name": "keenvpn-backend",
  "version": "2.0.0",
  "description": "KeenVPN Backend API with TypeScript, Prisma, and Stripe subscription management",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "dev:tunnel": "TUNNELTO_ENABLED=true tsx watch src/server.ts",
    "dev:no-tunnel": "TUNNELTO_ENABLED=false tsx watch src/server.ts",
    "build": "npm run prisma:migrate:deploy && prisma generate && tsc",
    "test": "NODE_ENV=test jest --runInBand",
    "test:integration": "NODE_ENV=test jest --testPathPattern=integration --runInBand",
    "test:watch": "NODE_ENV=test jest --watch --runInBand",
    "test:coverage": "NODE_ENV=test jest --coverage --runInBand",
    "setup:tunnel": "./scripts/setup-tunnel.sh",
    "tunnel:start": "./scripts/start-tunnel.sh",
    "docker:setup": "./scripts/docker-setup.sh",
    "docker:dev": "./scripts/docker-dev.sh",
    "docker:clean": "./scripts/docker-clean.sh",
    "docker:test": "./scripts/docker-test.sh",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:build": "docker-compose build",
    "docker:ps": "docker-compose ps",
    "docker:shell": "docker-compose exec api sh",
    "docker:db": "docker-compose exec postgres psql -U keenvpn",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "prisma:pull": "prisma db pull",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate",
    "type-check": "tsc --noEmit",
    "migrate:data": "tsx scripts/migrate-data.ts",
    "verify:migration": "tsx scripts/verify-migration.ts",
    "db:export": "tsx export-data-from-supabase.ts",
    "db:import": "tsx import-data-to-new-db.ts",
    "seed:vpn-config": "tsx prisma/seed-vpn-config.ts",
    "seed:vpn-config-demo": "tsx prisma/seed-vpn-config-demo.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.17.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/node-fetch": "^2.6.9",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "firebase-admin": "^11.11.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "prisma": "^6.17.0",
    "resend": "^6.5.2",
    "serverless-http": "^3.2.0",
    "stripe": "^14.7.0",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@jest/test-sequencer": "^30.2.0",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "jest-mock-extended": "^3.0.5",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0"
  },
  "keywords": [
    "express",
    "api",
    "prisma",
    "supabase",
    "postgresql",
    "firebase",
    "stripe",
    "subscription",
    "netlify",
    "serverless"
  ],
  "author": "KeenVPN Team",
  "license": "MIT"
}
